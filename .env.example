# CodeGuardian AI — environment variable template.
# --------------------------------------------------------------------------- #
# LLM Configuration
# --------------------------------------------------------------------------- #
# Default provider is Gemini. To use Groq, set LLM_PROVIDER=groq
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback provider: Groq
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-20b

# Gemini API key (Fallback LLM provider).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Security Scanners:
# Ensure bandit and semgrep are installed in the backend/venv.
# For Gitleaks, download the native binary from https://github.com/gitleaks/gitleaks/releases
# and place it in your PATH or backend/venv/Scripts/ (Windows) / backend/venv/bin/ (Linux/Mac).

# GitHub personal access token / app token (read PR diffs, post comments, open branches).
GITHUB_TOKEN=

# Shared secret used to verify the X-Hub-Signature-256 HMAC on incoming webhooks.
GITHUB_WEBHOOK_SECRET=

# GitHub App (Session 8 — replaces the PAT for multi-tenant reviews & user auth)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Secret key used to sign dashboard session JWTs (HS256)
SESSION_SECRET=

# PostgreSQL connection string (SQLAlchemy URL). Matches docker-compose credentials.
DATABASE_URL=postgresql+psycopg2://guardian:guardian@localhost:5432/codeguardian

# Local directory where ChromaDB persists its vector store.
CHROMA_PERSIST_DIR=./chroma_db

# Comma-separated browser origins allowed to call the API (dashboard dev server).
# Deliberately not "*": these endpoints create branches and record human approvals.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
